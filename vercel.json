{
  "version": 3,
  "builds": [
    {
      "src": "marche_agricole/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/marche_agricole/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/marche_agricole/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "marche_agricole/wsgi.py"
    }
  ]
}